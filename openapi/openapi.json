  "components": {
    "schemas": {
      "AddMemberRequest": {
        "type": "object",
        "required": [
          "user_id",
          "role"
        ],
        "properties": {
          "can_delete": {
            "type": "boolean"
          },
          "can_edit": {
            "type": "boolean"
          },
          "can_view": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "BookCard": {
        "type": "object",
        "required": [
          "id",
          "library_id",
          "title",
          "author",
          "category",
          "cover_url"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "cover_url": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_read_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "library_id": {
            "type": "string"
          },
          "reading_percent": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "BookDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BookCard"
          },
          {
            "type": "object",
            "required": [
              "metadata",
              "book_file_path",
              "sync_status",
              "uploaded_at",
              "updated_at",
              "permissions"
            ],
            "properties": {
              "book_file_path": {
                "type": "string"
              },
              "metadata": {
                "$ref": "#/components/schemas/BookMetadata"
              },
              "permissions": {
                "$ref": "#/components/schemas/PermissionFlags"
              },
              "sync_status": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              },
              "uploaded_at": {
                "type": "string"
              }
            }
          }
        ]
      },
      "BookMetadata": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "author": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "isbn": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "original_title": {
            "type": "string"
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "publish_date": {
            "type": "string",
            "description": "出版日期，格式 `YYYY-MM`（如 2024-02）"
          },
          "publisher": {
            "type": "string"
          },
          "reading_progress": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReadingProgress"
              }
            ]
          },
          "series": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "translator": {
            "type": "string"
          }
        }
      },
      "CreateLibraryRequest": {
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "HomeResponse": {
        "type": "object",
        "required": [
          "recent",
          "new_arrivals",
          "aha_moment"
        ],
        "properties": {
          "aha_moment": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookCard"
            },
            "description": "啊哈时刻：随机推荐"
          },
          "new_arrivals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookCard"
            },
            "description": "新书速递：按 uploaded_at 降序"
          },
          "recent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookCard"
            },
            "description": "最近阅读：按 last_read_at 降序，有阅读进度的优先展示"
          }
        }
      },
      "LibraryDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "root_path",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "root_path": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "LibraryMemberDto": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PermissionFlags"
          },
          {
            "type": "object",
            "required": [
              "user_id",
              "username",
              "role"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "user_id": {
                "type": "string"
              },
              "username": {
                "type": "string"
              }
            }
          }
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
